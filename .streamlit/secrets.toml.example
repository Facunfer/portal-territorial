# Copiá este archivo como secrets.toml y completá con tus credenciales reales.
# NUNCA commitees secrets.toml — está en el .gitignore.

[supabase]
url = "https://TU_PROJECT_ID.supabase.co"

# ⚠️  IMPORTANTE: usar la clave "anon" / "public", NO la "service_role".
# La encontrás en: Supabase Dashboard → Settings → API → Project API keys → anon (public)
# La service_role bypasea Row Level Security y NO debe usarse en aplicaciones cliente.
anon_key = "TU_ANON_KEY_AQUI"

# Solo necesario para scripts de migración que corren server-side (fuera del app).
# NUNCA lo uses en secrets.toml del app Streamlit en producción.
# [postgres]
# host = "db.TU_PROJECT_ID.supabase.co"
# port = 5432
# database = "postgres"
# user = "postgres"
# password = "TU_PASSWORD_AQUI"
