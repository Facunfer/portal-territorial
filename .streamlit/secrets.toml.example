# Copiá este archivo como secrets.toml y completá con tus credenciales reales.
# NUNCA commitees secrets.toml — está en el .gitignore.

[supabase]
url = "https://TU_PROJECT_ID.supabase.co"
anon_key = "TU_ANON_KEY_AQUI"

[postgres]
host = "db.TU_PROJECT_ID.supabase.co"
port = 5432
database = "postgres"
user = "postgres"
password = "TU_PASSWORD_AQUI"
